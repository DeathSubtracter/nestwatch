# Synthetic BP event demo review values in mmHg (not diagnostic rules)
BP_REVIEW_SYSTOLIC_THRESHOLD=140
BP_REVIEW_DIASTOLIC_THRESHOLD=90

# Multisignal engineering fixtures, not clinical cutoffs
PATTERN_NORMALIZED_CHANGE_THRESHOLD=1.0
PATTERN_RELATIVE_SCALE_FLOOR=0.05
PATTERN_MIN_DAYS_PER_WINDOW=3
PATTERN_MIN_SAMPLES_PER_DAY=1
PATTERN_PERSISTENCE_DAYS=3
PATTERN_REVIEW_MIN_GROUPS=3
PATTERN_MIN_AVAILABLE_GROUPS=3
PATTERN_REQUIRED_SIGNALS=["blood_glucose","blood_pressure_systolic","blood_pressure_diastolic","resting_heart_rate","heart_rate_variability_sdnn"]
